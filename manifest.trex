<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.bengtcj.bp-charts" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name">BP Chart Extensions</name>
    <description>Custom D3 charts for the BP Diagnostic Tool.</description>
    <author name="BengtCJ" email="" organization="" website="https://bengtcj.github.io/b_tableau_extensions"/>
    <min-api-version>1.4</min-api-version>
    <source-location>
      <url>https://bengtcj.github.io/b_tableau_extensions/index.html</url>
    </source-location>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">BP Chart Extensions</text>
    </resource>
  </resources>
</manifest>